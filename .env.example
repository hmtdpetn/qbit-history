# Copy to .env next to docker-compose.yml. Never commit .env.

# Host address and port for the web UI.
# 127.0.0.1 exposes it only on this machine, which is the safe default. Set
# HISTORY_BIND=0.0.0.0 to reach it from your LAN, and only do that behind a
# firewall or an HTTPS reverse proxy.
HISTORY_BIND=127.0.0.1
HISTORY_PORT=28637

# Only needed to reach a qBittorrent *container* by its name. Set these to the
# Docker networks your qBittorrent containers are on, then uncomment the
# matching blocks in docker-compose.yml. Add QB_NETWORK_3, 4, … for more.
# Find a container's network with:
#   docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' <qb-container>
#QB_NETWORK_1=
#QB_NETWORK_2=

# Where the SQLite database (+WAL/SHM) lives on the host. Must be writable by uid 65532.
HISTORY_DATA_DIR=./data

# 32 random bytes, mode 0600, owned by uid 65532. Create with scripts/init-secrets.sh.
HISTORY_MASTER_KEY_FILE=./secrets/master.key

# First start only: bootstrap password for the local "admin" account (12-72 chars).
# Remove this line after the first successful login.
HISTORY_ADMIN_PASSWORD=

# 1 only when the UI is served over HTTPS (reverse proxy). Keep 0 for plain
# http://127.0.0.1, otherwise the session cookie is never sent and you cannot
# log in.
HISTORY_SECURE_COOKIE=0

# Keep 0 on Linux. Set to 1 only when running on Windows or macOS, where a
# bind-mounted file always reports mode 0777 and cannot be chmod-ed, which would
# otherwise (correctly) abort startup.
HISTORY_ALLOW_INSECURE_KEY_PERMS=0

# Resource limits. Collection needs almost nothing (~0.003 of a core for 500
# torrents), but a chart query is a short CPU spike and shares the same limit:
# below ~0.5 a single query visibly starves the collector.
HISTORY_MEM_LIMIT=256m
HISTORY_CPUS=1.0
HISTORY_VERSION=2.0.0
